[Unit]
Description=Guitare Hunter Bot
After=network.target

[Service]
User=ludovic
WorkingDirectory=/home/ludovic/GuitareHunter
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1920x1080x24" /home/ludovic/GuitareHunter/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


