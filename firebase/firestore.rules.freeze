rules_version = '2';
// GEL DE BASCULE (Phase B.5, voir docs/management/plans/CUTOVER_RUNBOOK.md) — variante
// lecture-seule de firestore.rules, déployée temporairement pendant la fenêtre de coupure.
//
// N'arrête PAS les écritures du bot (backend/*, Admin SDK) : le SDK Admin bypass toujours les
// règles de sécurité, par design Firebase — ce fichier ne bloque QUE les écritures directes
// depuis le client (frontend), qui pour certaines ne transitent jamais par le bot :
//   - chat Gemini (src/services/geminiChatService.js écrit directement dans deal_chat)
//   - plan de restauration, favori/rejet manuel, config utilisateur (firestoreService.js)
// Le bot lui-même DOIT être arrêté séparément (`sudo systemctl stop guitare-hunter`, étape 1 du
// runbook) — cette variante des règles est la seconde moitié du gel, pas un substitut.
//
// Déploiement : `firebase deploy --only firestore:rules` après avoir copié ce fichier par-dessus
// firestore.rules (ou --config pointé dessus). Restauration : redéployer l'original depuis git
// (`git checkout firebase/firestore.rules && firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/users/{userId} {
      allow read: if isAdmin();
    }
    match /{path=**}/guitar_deals/{dealId} {
      allow read: if isAdmin();
    }

    match /artifacts/{appId}/admin_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Lecture inchangée (l'app reste consultable pendant le gel) ; toute écriture bloquée.
    match /artifacts/{appId}/users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if false;
    }
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if false;
    }

    match /artifacts/{appId}/cities/{cityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Partage public : lecture laissée ouverte (aucun impact sur la migration), écriture gelée.
    match /shared_deals/{dealId} {
      allow read: if true;
      allow write: if false;
    }

  }
}
